Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /GroundCloud1
        - /ObstacleCloud1
        - /CeilingCloud1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:

    - Class: rviz_default_plugins/PointCloud2
      Name: AlignedCloud
      Enabled: false
      Topic:
        Value: /local_mapper/debug/aligned_cloud
        Depth: 5
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Flat Color:
        R: 0.7
        G: 0.7
        B: 0.7
        A: 1.0
      Alpha: 0.4
      Decay Time: 0

    - Class: rviz_default_plugins/PointCloud2
      Name: GroundCloud
      Enabled: true
      Topic:
        Value: /local_mapper/debug/ground_cloud
        Depth: 5
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Flat Color:
        R: 0.1
        G: 0.85
        B: 0.1
        A: 1.0
      Alpha: 1.0
      Decay Time: 0

    - Class: rviz_default_plugins/PointCloud2
      Name: ObstacleCloud
      Enabled: true
      Topic:
        Value: /local_mapper/debug/obstacle_cloud
        Depth: 5
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Flat Color:
        R: 0.9
        G: 0.15
        B: 0.1
        A: 1.0
      Alpha: 1.0
      Decay Time: 0

    - Class: rviz_default_plugins/PointCloud2
      Name: CeilingCloud
      Enabled: true
      Topic:
        Value: /local_mapper/debug/ceiling_cloud
        Depth: 5
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Flat Color:
        R: 0.1
        G: 0.6
        B: 1.0
        A: 1.0
      Alpha: 0.8
      Decay Time: 0

    - Class: rviz_default_plugins/Axes
      Name: CameraFrame
      Enabled: true
      Reference Frame: camera_depth_optical_frame
      Length: 0.3
      Radius: 0.02

    - Class: rviz_default_plugins/Axes
      Name: GravityAlignedFrame
      Enabled: true
      Reference Frame: gravity_aligned_frame
      Length: 0.5
      Radius: 0.03

    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: gravity_aligned_frame
      Plane: XY
      Cell Size: 0.5
      Line Style: Lines
      Color:
        R: 0.5
        G: 0.5
        B: 0.5
        A: 1.0
      Normal Cell Count: 0
      Plane Cell Count: 10
      Alpha: 0.4

  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: gravity_aligned_frame
    Frame Rate: 30

  Tools:
    - Class: rviz_default_plugins/MoveCamera

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Orbit
      Distance: 4.5
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 2.0
      Yaw: 4.7144
      Pitch: -1.5698
      Focal Shape Size: 0.05
      Near Clip Distance: 0.01

Window Geometry:
  Width: 1400
  Height: 850
  Displays:
    collapsed: false
  Views:
    collapsed: false
