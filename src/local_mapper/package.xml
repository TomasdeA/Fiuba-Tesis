<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>local_mapper</name>
  <version>0.1.0</version>
  <description>
    Mapeador de grilla de ocupación local basado en imágenes de profundidad,
    IMU y odometría visual. Implementación incremental desde componentes
    básicos (proyección 3D) hasta el nodo ROS 2 completo.
  </description>

  <maintainer email="tdeaguirre@fi.uba.ar">dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>nav_math</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>rclpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
