<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>local_mapper</name>
  <version>0.1.0</version>
  <description>
    Mapeador de grilla de ocupación 2D en log-odds. Consume la nube de
    obstáculos publicada por depth_obstacle_filter y construye un
    nav_msgs/OccupancyGrid incremental en el frame odom.
  </description>

  <maintainer email="tdeaguirre@fi.uba.ar">dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>message_filters</depend>
  <depend>nav_math</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
