[Unit]
Description=Nav Mapper — ROS2 perception + haptic feedback stack
Documentation=https://github.com/your-repo/nav_mapper
# Esperar a que el sistema de red esté disponible (necesario para DDS/ROS2)
After=network.target docker.service
Requires=docker.service
# Si el controlador GPIO tiene su propio servicio separado, no hace falta
# listarlo aquí porque ya se lanza desde nav.launch.py con use_gpio_recorder=true

[Service]
# ── Usuario ────────────────────────────────────────────────────────────────
User=tomasdea
Group=tomasdea

# ── Variables de entorno ───────────────────────────────────────────────────
Environment="HOME=/home/tomasdea"
Environment="ROS_DOMAIN_ID=0"
# WS_PATH es usado por nav.launch.py para localizar el config de parámetros
Environment="WS_PATH=/home/tomasdea/Tesis/develop/Fiuba-Tesis"

# ── Comando de arranque ────────────────────────────────────────────────────
# Levanta un contenedor efímero (--rm) con docker-compose.raspi.yml.
# bash -l sourcea /etc/profile.d/context.sh (montado en el compose),
# que a su vez sourcea ROS2 y el workspace — equivalente a tesis-run.
ExecStart=/usr/bin/docker compose \
  -f ${WS_PATH}/docker-compose.raspi.yml \
  run --rm dev \
  bash -lc 'exec ros2 launch nav_bringup nav.launch.py'

# ── Política de reinicio ───────────────────────────────────────────────────
# Se reinicia automáticamente si el proceso termina con error.
Restart=on-failure
RestartSec=5s

# Tiempo máximo para que todos los nodos hijos cierren al detener el servicio.
# ros2 bag record necesita tiempo para hacer flush y cerrar el bag limpiamente.
TimeoutStopSec=30s

# ── Salida ─────────────────────────────────────────────────────────────────
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nav-mapper

[Install]
WantedBy=multi-user.target
