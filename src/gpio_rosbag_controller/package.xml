<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gpio_rosbag_controller</name>
  <version>0.1.0</version>
  <description>
    Lightweight GPIO-driven rosbag recorder controller for Raspberry Pi.
    A physical switch starts/stops recording; an LED provides visual feedback.
  </description>
  <maintainer email="dev@todo.todo">dev</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <!-- libgpiod is required on the system: sudo apt install libgpiod-dev -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
